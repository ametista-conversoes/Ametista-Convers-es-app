# Copie este arquivo para .env.local e preencha com as chaves do seu projeto Supabase
# (Painel do Supabase > Project Settings > API).
#
# Use a "Project URL" e a "anon public key". NUNCA use a "service_role key" aqui —
# essa é secreta e não deve entrar em código de frontend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
